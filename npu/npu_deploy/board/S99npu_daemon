#!/bin/sh
# S99npu_daemon —— 开机启动 NPU 识别常驻进程（写 /tmp/npu.status 给 HMI 用）
#
# HMI 每 500 ms 读 /tmp/npu.status：0=正常(绿) 1=突变(红) 其它=无结果(灰)
#
# 重要：hard_npu 是独占设备，同一时刻只能有一个进程打开它。
#       所以跑 batch46.sh / threeclass_live / 单例推理之前，要先 stop 这个服务。

HERE=/opt/npu/threeclass
DAEMON=/opt/npu/tc/npu_daemon
STATUS=/tmp/npu.status
LOG=/tmp/npu_daemon.log

start() {
    [ -x "$DAEMON" ] || { echo "no $DAEMON"; exit 0; }
    if pidof npu_daemon >/dev/null 2>&1; then echo "already running"; exit 0; fi
    sh /etc/init.d/S98npu start >/dev/null 2>&1
    [ -e /dev/hard_npu ] || { echo "hard_npu not ready"; exit 0; }
    export LD_LIBRARY_PATH=/opt/npu/lib
    export LD_PRELOAD=/opt/npu/lib/libsoftnpu_shim.so
    cd "$HERE" || exit 0
    nohup "$DAEMON" --model models/condition_threeclass_uint8.onnx \
        --status "$STATUS" --hop 0.5 >> "$LOG" 2>&1 &
    sleep 1
    echo "npu_daemon started (pid $(pidof npu_daemon))"
}

stop() {
    killall npu_daemon 2>/dev/null
    rm -f "$STATUS"
    echo "npu_daemon stopped"
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if pidof npu_daemon >/dev/null 2>&1; then
            echo "running: $(cat $STATUS 2>/dev/null)"; tail -1 /tmp/npu.log 2>/dev/null
        else
            echo "stopped"
        fi
        ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
